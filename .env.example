# 本地默认 SQLite；服务器单机 SQLite 配置见 deploy/.env.example。
KANBAN_ENVIRONMENT=development
KANBAN_DATABASE_URL=sqlite:///./data/kanban.db
KANBAN_PUBLIC_URL=http://127.0.0.1:5173
KANBAN_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Docker Compose 使用独立数据库凭据，不要提交真实 .env。
POSTGRES_PASSWORD=replace-with-a-long-random-password
