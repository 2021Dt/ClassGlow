ARG PYTHON_IMAGE=python:3.13-slim
FROM ghcr.io/astral-sh/uv:0.9.9 AS uv
FROM ${PYTHON_IMAGE}
COPY --from=uv /uv /usr/local/bin/uv
# 业务固定使用 Asia/Shanghai，精简系统也必须提供完整时区数据库。
RUN apt-get update && apt-get install -y --no-install-recommends tzdata \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --locked --no-dev --no-install-project
COPY backend ./backend
COPY scripts ./scripts
COPY alembic.ini ./
# 固定普通用户，数据卷初次创建继承目录所有者；业务进程不以 root 运行。
RUN groupadd --gid 10001 kanban && useradd --uid 10001 --gid 10001 --no-create-home kanban \
    && mkdir -p /app/data && chown 10001:10001 /app/data
USER 10001:10001
ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8000
# 仅 Compose 内部网络可达此端口，可信代理负责覆盖外部伪造的转发头。
CMD ["uvicorn", "backend.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*", "--no-access-log"]
