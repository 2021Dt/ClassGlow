# 只填写已经解析到服务器的域名，不加协议、路径或端口。
KANBAN_DOMAIN=teacher.dgplus.vip
# 单机试点先用 SQLite；数据保存在 Docker 命名卷，不能放在容器临时层。
KANBAN_DATABASE_URL=sqlite:////app/data/kanban.db
KANBAN_ALLOW_SQLITE_PRODUCTION=true
# 新登录默认保持 30 天，修改后部署生效；已签发会话沿用原到期时间。
KANBAN_SESSION_HOURS=720
KANBAN_SESSION_LIMIT=5
# 自动更新仅跟随 vX.Y.Z 稳定标签，默认在北京时间 02:00–05:00 部署。
KANBAN_UPDATE_WINDOW=02-05
# Linux 宿主机配置 journal 的 30 天保留与容量上限后，可把本项目容器日志接入 journal。
# KANBAN_JOURNAL_LOGS=true
# 共享服务器由现有 Nginx 负责 HTTPS 时添加 KANBAN_GATEWAY=nginx。
# Docker Hub 不可达时，可使用 Docker 官方在 Amazon ECR 的公开镜像：
# PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.13-slim
# NODE_IMAGE=public.ecr.aws/docker/library/node:24-alpine
# CADDY_IMAGE=public.ecr.aws/docker/library/caddy:2.11.7-alpine
# 仅当宿主机下载正常、Docker 桥接网络下载停滞时设置；不改变运行中容器网络。
# KANBAN_BUILD_NETWORK=host
# KANBAN_CLIENT_DOWNLOAD_URL=https://teacher.dgplus.vip/downloads/ClassGlow-win-x64.zip

# 共享 Nginx 模式下，本域名 /downloads/ 的限流默认值；修改后运行 classglow update。
# 速率单位为 KiB/s，1024 即每个下载连接 1 MiB/s。
# KANBAN_DOWNLOAD_RATE_KIB=1024
# KANBAN_DOWNLOAD_REQUESTS_PER_MINUTE=6
# KANBAN_DOWNLOAD_REQUESTS_TOTAL_PER_MINUTE=20
# KANBAN_DOWNLOAD_CONNECTIONS_PER_IP=2
# KANBAN_DOWNLOAD_CONNECTIONS_TOTAL=8
