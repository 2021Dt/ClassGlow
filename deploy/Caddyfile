{
	# 保留运行错误日志，不启用带邀请秘密和查询参数的访问日志。
	admin off
	servers {
		# 独立部署仅信任回环；已有 Nginx 模式由 Compose 显式启用内网代理。
		trusted_proxies static {$TRUSTED_PROXY_CIDRS:127.0.0.1/32}
		trusted_proxies_strict
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
	}
	# Windows 客户端服务地址也应填写 https://域名/api/，统一从此处进入。
	handle_path /api/* {
		request_body {
			# 自由画布包含压缩图片；应用层对其他接口仍限制为 128 KiB。
			max_size 2097152
		}
		reverse_proxy {$API_UPSTREAM:api:8000}
	}
	handle {
		root * {$WEB_ROOT:/srv}
		# 防止旧首页引用已删除的资源；带哈希的资源仍可由浏览器正常缓存。
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
