<UserControl x:Class="ClassroomBoard.ClassroomToolsPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <Grid Margin="28,8,28,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18">
   <TextBlock Text="课堂工具" Style="{StaticResource GlowHeading}" FontSize="26"/>
   <TextBlock Text="名单、课堂活动与讲课工具，离线也能使用。" Style="{StaticResource GlowHint}" Margin="0,6,0,0"/>
   <WrapPanel Margin="0,10,0,0">
    <ComboBox x:Name="ClassSelector" Width="210" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="ClassSelector_Changed" Margin="0,0,10,0" AutomationProperties.Name="当前本地班级名单"/>
    <ui:Button Content="新增班级" Click="AddClass_Click" Style="{StaticResource GlowQuiet}"/>
    <ui:Button Content="改名" Click="RenameClass_Click" Style="{StaticResource GlowQuiet}"/>
    <ui:Button Content="删除班级" Click="DeleteClass_Click" Style="{StaticResource GlowQuiet}"/>
    <ui:Button Content="本次缺席" Click="Absence_Click" Style="{StaticResource GlowSecondary}"/>
   </WrapPanel>
  </StackPanel>
  <TabControl x:Name="ToolTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,14,0,0">
   <TabItem Header="抽签与分组">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <Grid Margin="0,4,4,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="名单或签条" Style="{StaticResource GlowLabel}" FontWeight="SemiBold"/>
       <TextBlock Text="一行一项，可填写姓名、学号或题目。同名学生请附学号；完全相同的条目会合并。" Style="{StaticResource GlowHint}" Margin="0,8,0,10"/>
       <TextBox x:Name="RosterInput" Height="210" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12" MaxLength="30500" AutomationProperties.Name="名单或签条，一行一项" TextChanged="RosterInput_Changed"/>
       <WrapPanel Margin="0,12,0,4">
        <ui:Button Content="导入文件…" Style="{StaticResource GlowSecondary}" Click="ImportRoster_Click"/>
        <ui:Button x:Name="SaveRosterButton" Content="保存并使用" Style="{StaticResource GlowPrimary}" Click="SaveRoster_Click"/>
        <ui:Button Content="清空名单" Style="{StaticResource GlowQuiet}" Click="ClearRoster_Click"/>
       </WrapPanel>
       <TextBlock Text="名单仅在这台电脑加密保存，不上传。抽取轮次在退出程序后重置。" Style="{StaticResource GlowHint}" Margin="0,10,0,0"/>
       <TextBlock x:Name="RosterSummary" Style="{StaticResource GlowLabel}" Margin="0,12,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
       <TextBlock Text="随机点名 / 抽签" Style="{StaticResource GlowLabel}" FontWeight="SemiBold"/>
       <WrapPanel Margin="0,10,0,10" VerticalAlignment="Center">
        <TextBlock Text="每次抽取" Style="{StaticResource GlowLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="DrawCountInput" Text="1" Width="54" MaxLength="2" Padding="8" AutomationProperties.Name="每次抽取数量"/>
        <TextBlock Text="项" Style="{StaticResource GlowLabel}" VerticalAlignment="Center" Margin="8,0,12,0"/>
        <ui:Button x:Name="DrawButton" Content="抽取" Style="{StaticResource GlowPrimary}" Click="Draw_Click"/>
        <ui:Button x:Name="ResetRoundButton" Content="新一轮" Style="{StaticResource GlowQuiet}" Margin="8,0,0,0" Click="ResetRound_Click"/>
       </WrapPanel>
       <WrapPanel>
        <CheckBox x:Name="NoRepeat" Content="本轮不重复抽取" IsChecked="True"/>
        <TextBlock x:Name="RoundSummary" Style="{StaticResource GlowHint}" VerticalAlignment="Center" Margin="12,0,0,0"/>
       </WrapPanel>
       <Border BorderBrush="{DynamicResource GlowLine}" BorderThickness="0,1,0,0" Margin="0,12,0,10"/>
       <TextBlock Text="随机均衡分组" Style="{StaticResource GlowLabel}" FontWeight="SemiBold"/>
       <WrapPanel Margin="0,10,0,4">
        <TextBlock Text="分成" Style="{StaticResource GlowLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="GroupCountInput" Text="4" Width="54" MaxLength="2" Padding="8" AutomationProperties.Name="分组数量"/>
        <TextBlock Text="组" Style="{StaticResource GlowLabel}" VerticalAlignment="Center" Margin="8,0,12,0"/>
        <ui:Button x:Name="GroupButton" Content="生成分组" Style="{StaticResource GlowSecondary}" Click="Group_Click"/>
       </WrapPanel>
       <TextBlock Text="跳过本次缺席，每组人数最多相差 1 人，不影响抽签轮次。" Style="{StaticResource GlowHint}" Margin="0,8,0,10"/>
       <Border Style="{StaticResource GlowCard}" Padding="16">
        <StackPanel>
         <TextBlock x:Name="ResultTitle" Text="抽取和分组结果" Style="{StaticResource GlowHint}" Margin="0,0,0,8"/>
         <TextBox x:Name="Results" Text="先保存一份名单" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="140" FontSize="28" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="抽取和分组结果"/>
        </StackPanel>
       </Border>
       <ui:Button x:Name="CopyButton" Content="复制结果" Style="{StaticResource GlowQuiet}" HorizontalAlignment="Left" IsEnabled="False" Margin="0,8,0,0" Click="Copy_Click"/>
       <ui:Button x:Name="SendGroupsButton" Content="将分组送到积分板" Style="{StaticResource GlowSecondary}" HorizontalAlignment="Left" IsEnabled="False" Click="SendGroups_Click"/>
      </StackPanel>
     </Grid>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="本地倒计时">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel MaxWidth="520" Margin="0,10,0,20" HorizontalAlignment="Center">
      <TextBlock Text="限时完成一个课堂任务" Style="{StaticResource GlowHeading}"/>
      <TextBlock Text="不用手机下发，未绑定或断网时也能启动。到点显示“时间到”，5 秒后关闭。" Style="{StaticResource GlowHint}" Margin="0,10,0,20"/>
      <TextBlock Text="任务说明（选填）" Style="{StaticResource GlowLabel}" Margin="0,0,0,8"/>
      <TextBox x:Name="TimerLabelInput" MaxLength="60" Padding="12" AutomationProperties.Name="倒计时任务说明"/>
      <TextBlock Text="计时时长" Style="{StaticResource GlowLabel}" Margin="0,20,0,8"/>
      <WrapPanel VerticalAlignment="Center">
       <TextBox x:Name="MinutesInput" Text="5" Width="80" MaxLength="2" FontSize="24" Padding="12" AutomationProperties.Name="倒计时分钟"/>
       <TextBlock Text="分" Style="{StaticResource GlowLabel}" VerticalAlignment="Center" Margin="10,0,20,0"/>
       <TextBox x:Name="SecondsInput" Text="0" Width="80" MaxLength="2" FontSize="24" Padding="12" AutomationProperties.Name="倒计时秒数"/>
       <TextBlock Text="秒" Style="{StaticResource GlowLabel}" VerticalAlignment="Center" Margin="10,0,0,0"/>
      </WrapPanel>
      <WrapPanel Margin="0,12,0,14">
       <ui:Button Content="1 分钟" Tag="1" Style="{StaticResource GlowQuiet}" Click="Preset_Click"/>
       <ui:Button Content="3 分钟" Tag="3" Style="{StaticResource GlowQuiet}" Click="Preset_Click"/>
       <ui:Button Content="5 分钟" Tag="5" Style="{StaticResource GlowQuiet}" Click="Preset_Click"/>
       <ui:Button Content="10 分钟" Tag="10" Style="{StaticResource GlowQuiet}" Click="Preset_Click"/>
      </WrapPanel>
      <CheckBox x:Name="TimerCard" Content="使用悬浮卡片显示" IsChecked="True" Margin="0,0,0,18"/>
      <TextBlock Text="显示在“展示设置”选定的屏幕，最长 60 分钟。新倒计时会替换当前提醒；锁屏或退出程序时结束。" Style="{StaticResource GlowHint}" Margin="0,0,0,16"/>
      <WrapPanel>
       <ui:Button x:Name="StartTimerButton" Content="开始倒计时" Style="{StaticResource GlowPrimary}" Click="StartTimer_Click"/>
       <ui:Button x:Name="StopTimerButton" Content="结束本地倒计时" Style="{StaticResource GlowSecondary}" Margin="10,0,0,0" Click="StopTimer_Click" IsEnabled="False"/>
      </WrapPanel>
      <TextBlock x:Name="TimerStatus" Style="{StaticResource GlowHint}" Margin="0,16,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
  <TextBlock x:Name="Feedback" Grid.Row="2" Style="{StaticResource GlowLabel}" TextWrapping="Wrap" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</UserControl>
