<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <ResourceDictionary.MergedDictionaries>
  <ui:ThemesDictionary Theme="Light" />
  <ui:ControlsDictionary />
  <ResourceDictionary Source="ClientArtwork.xaml" />
 </ResourceDictionary.MergedDictionaries>
 <SolidColorBrush x:Key="GlowText" Color="#202126" />
 <SolidColorBrush x:Key="GlowMuted" Color="#727680" />
 <SolidColorBrush x:Key="GlowAccent" Color="#2478ED" />
 <SolidColorBrush x:Key="GlowOnAccent" Color="White" />
 <SolidColorBrush x:Key="GlowSurface" Color="#D9FFFFFF" />
 <SolidColorBrush x:Key="GlowCardEdge" Color="#F2FFFFFF" />
 <LinearGradientBrush x:Key="GlowPrimaryFill" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#3989F9" /><GradientStop Color="#1970E8" Offset="1" /></LinearGradientBrush>
 <SolidColorBrush x:Key="GlowPrimaryHover" Color="#398AF9" />
 <SolidColorBrush x:Key="GlowPrimaryPressed" Color="#1461CA" />
 <SolidColorBrush x:Key="GlowInset" Color="#0C357EF1" />
 <SolidColorBrush x:Key="GlowLine" Color="#120F203B" />
 <SolidColorBrush x:Key="GlowSwitchOff" Color="#D9DCE2" />
 <SolidColorBrush x:Key="GlowKnob" Color="White" />
 <SolidColorBrush x:Key="GlowProgressIdle" Color="#CCD0D8" />
 <CornerRadius x:Key="ControlCornerRadius">9</CornerRadius>
 <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#2478ED" />
 <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#1769D7" />
 <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#125BC0" />
 <SolidColorBrush x:Key="CheckBoxCheckBorderBrush" Color="#2478ED" />
 <Style x:Key="GlowCard" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource GlowSurface}" />
  <Setter Property="BorderBrush" Value="{DynamicResource GlowCardEdge}" />
  <Setter Property="BorderThickness" Value="1" />
  <Setter Property="CornerRadius" Value="22" />
  <Setter Property="Padding" Value="24" />
  <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#3A4A66" BlurRadius="24" ShadowDepth="6" Opacity="0.06" /></Setter.Value></Setter>
 </Style>
 <Style x:Key="GlowLabel" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource GlowText}" />
  <Setter Property="FontSize" Value="14" />
  <Setter Property="TextWrapping" Value="Wrap" />
 </Style>
 <Style x:Key="GlowHint" TargetType="TextBlock" BasedOn="{StaticResource GlowLabel}">
  <Setter Property="Foreground" Value="{DynamicResource GlowMuted}" />
  <Setter Property="FontSize" Value="13" />
  <Setter Property="LineHeight" Value="20" />
 </Style>
 <Style x:Key="GlowHeading" TargetType="TextBlock" BasedOn="{StaticResource GlowLabel}">
  <Setter Property="FontSize" Value="16" />
  <Setter Property="FontWeight" Value="SemiBold" />
 </Style>
 <Style x:Key="GlowPageTitle" TargetType="TextBlock" BasedOn="{StaticResource GlowHeading}">
  <Setter Property="FontSize" Value="28" />
  <Setter Property="TextAlignment" Value="Center" />
  <Setter Property="Margin" Value="0,16,0,28" />
 </Style>
 <Style x:Key="GlowSecondary" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
  <Setter Property="Appearance" Value="Secondary" />
  <Setter Property="Background" Value="{DynamicResource GlowSurface}" />
  <Setter Property="Foreground" Value="{DynamicResource GlowText}" />
  <Setter Property="BorderBrush" Value="{DynamicResource GlowLine}" />
  <Setter Property="MouseOverBackground" Value="{DynamicResource GlowSurface}" />
  <Setter Property="MouseOverBorderBrush" Value="{DynamicResource GlowMuted}" />
  <Setter Property="PressedBackground" Value="{DynamicResource GlowInset}" />
  <Setter Property="Padding" Value="22,10" />
  <Setter Property="CornerRadius" Value="20" />
  <Setter Property="MinHeight" Value="40" />
  <Setter Property="FontSize" Value="13" />
 </Style>
 <Style x:Key="GlowPrimary" TargetType="ui:Button" BasedOn="{StaticResource GlowSecondary}">
  <Setter Property="Background" Value="{DynamicResource GlowPrimaryFill}" />
  <Setter Property="Foreground" Value="{DynamicResource GlowOnAccent}" />
  <Setter Property="BorderBrush" Value="{DynamicResource GlowAccent}" />
  <Setter Property="MouseOverBackground" Value="{DynamicResource GlowPrimaryHover}" />
  <Setter Property="MouseOverBorderBrush" Value="{DynamicResource GlowAccent}" />
  <Setter Property="PressedBackground" Value="{DynamicResource GlowPrimaryPressed}" />
  <Setter Property="PressedForeground" Value="{DynamicResource GlowOnAccent}" />
  <Setter Property="FontWeight" Value="SemiBold" />
 </Style>
 <Style x:Key="GlowQuiet" TargetType="ui:Button" BasedOn="{StaticResource GlowSecondary}">
  <Setter Property="Appearance" Value="Transparent" />
  <Setter Property="Background" Value="Transparent" />
  <Setter Property="BorderBrush" Value="Transparent" />
  <Setter Property="MouseOverBackground" Value="{DynamicResource GlowInset}" />
  <Setter Property="MouseOverBorderBrush" Value="Transparent" />
  <Setter Property="Foreground" Value="{DynamicResource GlowMuted}" />
  <Setter Property="Padding" Value="16,10" />
 </Style>
 <!-- 开关保留 CheckBox 的键盘与自动化语义，只统一外观，不改变保存时机。 -->
 <Style x:Key="GlowSwitch" TargetType="CheckBox">
  <Setter Property="Foreground" Value="{DynamicResource GlowText}" />
  <Setter Property="FontSize" Value="15" />
  <Setter Property="MinHeight" Value="58" />
  <Setter Property="VerticalContentAlignment" Value="Center" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
   <Grid Background="Transparent">
    <ContentPresenter Margin="0,0,62,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
    <Border x:Name="Track" Width="44" Height="26" CornerRadius="13" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource GlowSwitchOff}">
     <Border x:Name="Knob" Width="22" Height="22" CornerRadius="11" Margin="2" HorizontalAlignment="Left" Background="{DynamicResource GlowKnob}">
      <Border.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.16" /></Border.Effect>
     </Border>
    </Border>
    <Border x:Name="FocusRing" Width="50" Height="32" CornerRadius="16" HorizontalAlignment="Right" Margin="0,0,-3,0" VerticalAlignment="Center" BorderBrush="{DynamicResource GlowAccent}" BorderThickness="2" Opacity="0" IsHitTestVisible="False" />
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource GlowAccent}" /><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" /></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Opacity" Value="0.65" /></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.85" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="GlowDisclosureToggle" TargetType="ToggleButton">
  <Setter Property="Foreground" Value="{DynamicResource GlowMuted}" />
  <Setter Property="FontSize" Value="12" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
   <Border x:Name="Hover" Background="Transparent" CornerRadius="10" Padding="10,10">
    <Grid><ContentPresenter Margin="0,0,24,0" VerticalAlignment="Center" /><Path x:Name="Chevron" Data="M 0,0 L 4,4 L 8,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="4" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform /></Path.RenderTransform></Path></Grid>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Background" Value="{DynamicResource GlowInset}" /></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Hover" Property="Background" Value="{DynamicResource GlowInset}" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="GlowDisclosure" TargetType="Expander">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
   <StackPanel>
    <ToggleButton Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Style="{StaticResource GlowDisclosureToggle}" />
    <ContentPresenter x:Name="Details" Visibility="Collapsed" Margin="10,6,10,8" />
   </StackPanel>
   <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="GlowRowIcon" TargetType="Border">
  <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" /><Setter Property="CornerRadius" Value="10" />
  <Setter Property="Background" Value="{DynamicResource GlowInset}" /><Setter Property="Margin" Value="0,0,14,0" /><Setter Property="VerticalAlignment" Value="Center" />
 </Style>
</ResourceDictionary>
