<UserControl x:Class="ClassroomBoard.ClientPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <Grid Margin="32,0,32,24" MaxWidth="560">
  <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Center">
   <!-- 内容较少时整体居中，展开更多选项后自然滚动，底部导航始终固定。 -->
   <Grid MinHeight="{Binding ViewportHeight, ElementName=PageScroll}">
   <StackPanel x:Name="PageBody" Margin="16,20,16,24" MaxWidth="480" VerticalAlignment="Center">
    <Image x:Name="PageArt" Source="{StaticResource GlowConnectArt}" Width="119" Height="104" />
    <TextBlock x:Name="PageTitle" Text="连接班级" Style="{StaticResource GlowPageTitle}" />
    <Border x:Name="WallpaperConflictBox" Style="{StaticResource GlowCard}" Visibility="Collapsed" Margin="0,0,0,16">
     <StackPanel>
      <TextBlock Text="请先退出 Wallpaper Engine" Style="{StaticResource GlowLabel}" FontWeight="SemiBold" />
      <TextBlock Text="右键系统托盘里的 Wallpaper Engine 图标，选择“退出”，再重新检测。只关闭它的设置窗口不会退出壁纸。" Style="{StaticResource GlowHint}" Margin="0,8,0,12" />
      <ui:Button Content="我已退出，重新检测" Style="{StaticResource GlowQuiet}" HorizontalAlignment="Left" Click="RecheckWallpaper_Click" />
     </StackPanel>
    </Border>
    <StackPanel x:Name="ConnectPage">
     <Border Style="{StaticResource GlowCard}" Padding="26,24">
      <StackPanel>
       <Image x:Name="PairQr" Width="148" Height="148" Stretch="Uniform" Visibility="Collapsed" Margin="0,0,0,18" />
       <TextBlock x:Name="CodeLabel" Style="{StaticResource GlowHint}" TextAlignment="Center" Visibility="Collapsed" />
       <TextBlock x:Name="PairCode" Foreground="{DynamicResource GlowText}" FontSize="36" FontWeight="SemiBold" TextAlignment="Center" Visibility="Collapsed" Margin="0,8,0,6" TextWrapping="Wrap" />
       <TextBlock x:Name="PairHint" Text="10 分钟内有效" Style="{StaticResource GlowHint}" TextAlignment="Center" Visibility="Collapsed" />
       <ui:Button x:Name="PairButton" Content="生成绑定码" Style="{StaticResource GlowPrimary}" HorizontalAlignment="Center" MinWidth="180" Margin="0,12,0,0" Click="Pair_Click" />
       <TextBlock x:Name="ConnectionStatus" Text="在教师工作台“教室电脑”中输入绑定码。" Style="{StaticResource GlowHint}" TextAlignment="Center" Margin="0,18,0,4" />
      </StackPanel>
     </Border>
     <Expander Header="服务器地址" Style="{StaticResource GlowDisclosure}" Margin="8,12,8,0">
      <TextBox x:Name="ServerInput" Padding="10,8" AutomationProperties.Name="服务地址" />
     </Expander>
    </StackPanel>
    <StackPanel x:Name="DisplayPage" Visibility="Collapsed">
     <Border Style="{StaticResource GlowCard}" Padding="20,4">
      <StackPanel>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource GlowRowIcon}"><Path Data="M2,3 H18 V14 H2 Z M7,18 H13 M10,14 V18" Stroke="{DynamicResource GlowAccent}" StrokeThickness="1.4" StrokeLineJoin="Round" Width="20" Height="20" /></Border>
        <CheckBox x:Name="WallpaperEnabled" Grid.Column="1" Content="在桌面显示班级看板" Style="{StaticResource GlowSwitch}" Click="Wallpaper_Click" />
       </Grid>
       <StackPanel x:Name="MonitorPanel" Margin="46,0,0,12" Visibility="Collapsed">
        <Grid Margin="0,0,0,2">
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
         <TextBlock Text="显示器" Style="{StaticResource GlowHint}" VerticalAlignment="Center" Margin="0,0,16,0" />
         <ComboBox x:Name="MonitorChoice" Grid.Column="1" AutomationProperties.Name="展示的显示器" FontSize="13" Padding="10,7" BorderBrush="{DynamicResource GlowLine}" />
        </Grid>
       </StackPanel>
       <Border Height="1" Background="{DynamicResource GlowLine}" Margin="46,0,0,0" />
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource GlowRowIcon}"><Path Data="M10,2 V10 M5,5 A7,7 0 1 0 15,5" Stroke="{DynamicResource GlowAccent}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20" /></Border>
        <CheckBox x:Name="StartupEnabled" Grid.Column="1" Content="登录 Windows 时自动启动" Style="{StaticResource GlowSwitch}" />
       </Grid>
      </StackPanel>
     </Border>
    </StackPanel>
    <StackPanel x:Name="HomePage" Visibility="Collapsed">
     <Border Style="{StaticResource GlowCard}" Padding="26,22">
      <StackPanel>
       <TextBlock x:Name="StatusText" Style="{StaticResource GlowLabel}" TextAlignment="Center" Margin="0,0,0,22" />
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <ui:Button x:Name="HomePrimary" Content="立即同步" Style="{StaticResource GlowPrimary}" HorizontalAlignment="Stretch" Click="HomePrimary_Click" />
        <ui:Button x:Name="PauseButton" Grid.Column="2" Content="暂停展示" Style="{StaticResource GlowSecondary}" HorizontalAlignment="Stretch" Click="Pause_Click" />
       </Grid>
       <Expander Header="同步详情" Style="{StaticResource GlowDisclosure}" Margin="0,16,0,0">
        <TextBlock x:Name="TechnicalStatus" Style="{StaticResource GlowHint}" />
       </Expander>
      </StackPanel>
     </Border>
     <WrapPanel HorizontalAlignment="Center" Margin="0,14,0,0">
      <ui:Button Content="展示设置" Style="{StaticResource GlowQuiet}" Click="Settings_Click" />
      <ui:Button Content="绑定信息" Style="{StaticResource GlowQuiet}" Click="Binding_Click" />
      <ui:Button Content="隐私说明" Style="{StaticResource GlowQuiet}" Click="Privacy_Click" />
      <ui:Button Content="检查更新" Style="{StaticResource GlowQuiet}" Click="Update_Click" />
      <ui:Button Content="卸载软件" Style="{StaticResource GlowQuiet}" Click="Uninstall_Click" />
     </WrapPanel>
    </StackPanel>
    <Border x:Name="FeedbackBox" CornerRadius="14" Background="{DynamicResource GlowInset}" Padding="14" Margin="0,16,0,0" Visibility="Collapsed">
     <TextBlock x:Name="Feedback" Style="{StaticResource GlowLabel}" AutomationProperties.LiveSetting="Polite" />
    </Border>
   </StackPanel>
   </Grid>
  </ScrollViewer>
  <Grid x:Name="WizardActions" Grid.Row="1" Margin="0,12,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <ui:Button x:Name="BackButton" Content="稍后绑定" Style="{StaticResource GlowQuiet}" Click="Back_Click" HorizontalAlignment="Left" />
   <StackPanel x:Name="PageProgress" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
   <ui:Button x:Name="NextButton" Grid.Column="2" Content="继续" Style="{StaticResource GlowPrimary}" MinWidth="108" Click="Next_Click" HorizontalAlignment="Right" IsEnabled="False" />
  </Grid>
 </Grid>
</UserControl>
