<UserControl x:Class="ClassroomBoard.ClientPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <Grid Margin="32,8,32,22" MaxWidth="680">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,22">
   <TextBlock x:Name="StepLabel" Text="02 / 03　连接班级" Foreground="{DynamicResource GlowAccent}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
   <TextBlock x:Name="PageTitle" Text="连接这间教室" Foreground="{DynamicResource GlowText}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,8" />
   <TextBlock x:Name="PageHint" Text="用教师工作台完成一次绑定，之后自动同步。" Style="{StaticResource GlowHint}" TextAlignment="Center" />
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <StackPanel x:Name="ConnectPage" MaxWidth="520">
     <Border Style="{StaticResource GlowCard}">
      <StackPanel>
       <Image x:Name="BrandImage" Width="58" Height="58" Margin="0,2,0,18" />
       <Image x:Name="PairQr" Width="168" Height="168" Stretch="Uniform" Visibility="Collapsed" Margin="0,0,0,16" />
       <TextBlock x:Name="CodeLabel" Text="准备好这间教室" Style="{StaticResource GlowHeading}" TextAlignment="Center" />
       <TextBlock x:Name="PairCode" Foreground="{DynamicResource GlowText}" FontSize="34" FontWeight="SemiBold" TextAlignment="Center" Visibility="Collapsed" Margin="0,6,0,8" TextWrapping="Wrap" />
       <TextBlock x:Name="PairHint" Text="无需在教室电脑输入教师密码" Style="{StaticResource GlowHint}" TextAlignment="Center" />
       <ui:Button x:Name="PairButton" Content="生成绑定码" Style="{StaticResource GlowPrimary}" HorizontalAlignment="Stretch" Margin="0,24,0,0" Click="Pair_Click" />
       <TextBlock x:Name="ConnectionStatus" Text="手机或电脑打开教师工作台，在“大屏控制”中绑定设备。" Style="{StaticResource GlowHint}" TextAlignment="Center" Margin="0,18,0,0" />
      </StackPanel>
     </Border>
     <Expander Header="其他服务器" Margin="0,16,0,0">
      <StackPanel Margin="12,10,12,8">
       <TextBlock Text="通常无需修改。自建服务时，由管理员提供地址。" Style="{StaticResource GlowHint}" />
       <TextBox x:Name="ServerInput" Padding="10,8" Margin="0,8,0,0" AutomationProperties.Name="服务地址" />
      </StackPanel>
     </Expander>
    </StackPanel>
    <StackPanel x:Name="DisplayPage" MaxWidth="520" Visibility="Collapsed">
     <Border Style="{StaticResource GlowCard}">
      <StackPanel>
       <CheckBox x:Name="WallpaperEnabled" Content="在桌面显示班级看板" FontSize="16" Click="Wallpaper_Click" />
       <TextBlock Text="课件在前台时先保存内容，回到桌面后再更新。退出客户端会恢复原壁纸。" Style="{StaticResource GlowHint}" Margin="28,10,0,0" />
       <StackPanel x:Name="MonitorPanel" Margin="28,20,0,0" Visibility="Collapsed">
        <TextBlock Text="显示在哪块屏幕？" Style="{StaticResource GlowLabel}" Margin="0,0,0,8" />
        <ComboBox x:Name="MonitorChoice" AutomationProperties.Name="展示的显示器" Padding="10,8" />
       </StackPanel>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource GlowCard}" Margin="0,16,0,0">
      <StackPanel>
       <CheckBox x:Name="StartupEnabled" Content="登录 Windows 时自动启动" FontSize="16" />
       <TextBlock Text="下次登录电脑时自动运行。" Style="{StaticResource GlowHint}" Margin="28,10,0,0" />
      </StackPanel>
     </Border>
     <TextBlock Text="两项默认关闭。完成后也可以随时修改。" Style="{StaticResource GlowHint}" TextAlignment="Center" Margin="0,20,0,0" />
    </StackPanel>
    <StackPanel x:Name="HomePage" MaxWidth="520" Visibility="Collapsed">
     <Border Style="{StaticResource GlowCard}">
      <StackPanel>
       <Image x:Name="HomeBrandImage" Width="58" Height="58" Margin="0,4,0,20" />
       <TextBlock x:Name="ClassName" Text="还没有连接班级" Style="{StaticResource GlowHeading}" FontSize="22" TextAlignment="Center" />
       <TextBlock x:Name="StatusText" Style="{StaticResource GlowLabel}" TextAlignment="Center" Margin="0,8,0,8" />
       <TextBlock x:Name="StatusDetail" Style="{StaticResource GlowHint}" TextAlignment="Center" />
       <ui:Button x:Name="HomePrimary" Content="立即同步" Style="{StaticResource GlowPrimary}" HorizontalAlignment="Stretch" Margin="0,24,0,0" Click="HomePrimary_Click" />
       <ui:Button x:Name="PauseButton" Content="暂停这台电脑" HorizontalAlignment="Stretch" Padding="12,10" Margin="0,10,0,0" Click="Pause_Click" />
       <Expander Header="查看同步详情" Margin="0,18,0,0">
        <TextBlock x:Name="TechnicalStatus" Style="{StaticResource GlowHint}" Margin="0,10,0,0" />
       </Expander>
      </StackPanel>
     </Border>
     <WrapPanel HorizontalAlignment="Center" Margin="0,18,0,0">
      <ui:Button Content="展示设置" Click="Settings_Click" Appearance="Transparent" Padding="12,8" />
      <ui:Button Content="绑定信息" Click="Binding_Click" Appearance="Transparent" Padding="12,8" />
      <ui:Button Content="隐私与卸载" Click="Privacy_Click" Appearance="Transparent" Padding="12,8" />
      <ui:Button Content="检查更新" Click="Update_Click" Appearance="Transparent" Padding="12,8" />
     </WrapPanel>
    </StackPanel>
    <Border x:Name="FeedbackBox" MaxWidth="520" CornerRadius="10" Background="{DynamicResource GlowInset}" Padding="14" Margin="0,16,0,0" Visibility="Collapsed">
     <TextBlock x:Name="Feedback" Style="{StaticResource GlowLabel}" AutomationProperties.LiveSetting="Polite" />
    </Border>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,18,0,0">
   <Grid x:Name="WizardActions" Margin="0,0,0,20">
    <ui:Button x:Name="BackButton" Content="稍后绑定" Appearance="Transparent" Padding="16,10" Click="Back_Click" HorizontalAlignment="Left" />
    <ui:Button x:Name="NextButton" Content="下一步：展示方式" Style="{StaticResource GlowPrimary}" Click="Next_Click" HorizontalAlignment="Right" IsEnabled="False" />
   </Grid>
   <TextBlock x:Name="VersionLabel" Style="{StaticResource GlowHint}" HorizontalAlignment="Center" />
  </StackPanel>
 </Grid>
</UserControl>
